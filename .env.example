# Vector Database Benchmark Configuration
# Copy this file to .env and update values for your environment
# For Azure deployments, update hostnames to your Azure server addresses

# =============================================================================
# MILVUS CONFIGURATION
# =============================================================================
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Milvus 2.4 (for comparison testing)
MILVUS_24_HOST=localhost
MILVUS_24_PORT=19531

# =============================================================================
# WEAVIATE CONFIGURATION
# =============================================================================
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051

# =============================================================================
# POSTGRESQL CONFIGURATION (with pgvector)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vectordb

# =============================================================================
# SQL SERVER CONFIGURATION
# =============================================================================
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourStrong@Passw0rd
SQLSERVER_DB=vectordb
# ODBC Driver name (usually "ODBC Driver 18 for SQL Server" or "ODBC Driver 17 for SQL Server")
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
# Trust server certificate (set to yes for self-signed certs, no for production)
SQLSERVER_TRUST_CERT=yes

# =============================================================================
# EMBEDDING MODEL CONFIGURATION (Optional)
# =============================================================================
# Text embedding model (default: all-MiniLM-L6-v2)
TEXT_EMBEDDING_MODEL=all-MiniLM-L6-v2
TEXT_EMBEDDING_DIM=384

# Image embedding model (default: openai/clip-vit-base-patch32)
IMAGE_EMBEDDING_MODEL=openai/clip-vit-base-patch32
IMAGE_EMBEDDING_DIM=512

# =============================================================================
# DATA CONFIGURATION
# =============================================================================
# Directory containing processed multi-modal data (PDFs, Word docs, images)
DATA_OUTPUT_DIR=./data/multimodal

# =============================================================================
# BENCHMARK CONFIGURATION (Optional)
# =============================================================================
# Number of queries per benchmark run
BENCHMARK_NUM_QUERIES=10

# Batch size for document insertion
BATCH_SIZE=1000
